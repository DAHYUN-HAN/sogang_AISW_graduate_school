DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/sogang_app
APP_ENVIRONMENT=development
SEED_DEMO_DATA=true
AUTH_SECRET_KEY=change-me-in-production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY=false
RATE_LIMIT_TRUSTED_PROXY_IPS=
# Development/test may use '*'. Staging/production must list the public API
# hostname(s), without schemes or ports, and the proxy healthcheck must send
# one of these values as its Host header.
ALLOWED_HOSTS=*
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
SUPPORT_EMAIL=
PUBLIC_API_URL=
SUPPORT_URL=
PRIVACY_POLICY_URL=
ACCOUNT_DELETION_URL=
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_TIMEOUT_SECONDS=3
EMAIL_VERIFICATION_EXPIRE_MINUTES=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=300
PASSWORD_RESET_EXPIRE_MINUTES=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=300
# Staging/production must set an integer period approved by the privacy owner.
# ACCOUNT_DELETION_RECEIPT_RETENTION_DAYS=

# SMTP can be Gmail, Naver, SendGrid, AWS SES, your own domain SMTP, etc.
# The recipient domain is still restricted to @sogang.ac.kr by backend validation.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Use password for ordinary providers. Set none only for an explicitly approved
# IP-authenticated relay, and leave username/password empty in that mode.
SMTP_AUTH=password

# Use a sender address that your SMTP account/provider is allowed to send as.
# Example: if SMTP_USERNAME is myservice@gmail.com, SMTP_FROM_EMAIL should usually be myservice@gmail.com.
SMTP_FROM_EMAIL=
# Keep the product identity consistent in the visible From header. Do not include line breaks.
SMTP_FROM_NAME=AI·SW CAMPUS
# Optional monitored reply mailbox. Defaults to SMTP_FROM_EMAIL when empty.
SMTP_REPLY_TO=
# Use starttls for the usual submission port 587 or ssl for implicit TLS on 465.
# Plain SMTP is permitted only for isolated development/test capture servers.
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
# Must be longer than SMTP_TIMEOUT_SECONDS. Also set the same public value in EAS.
EXPO_PUBLIC_AUTH_EMAIL_TIMEOUT_MS=120000
# Deprecated fallback used only when SMTP_SECURITY is omitted.
SMTP_USE_TLS=true

# Set true in staging/production so a broken SMTP setup fails loudly instead of returning email_sent=false.
SMTP_REQUIRED=false

EXPO_PUSH_ENABLED=true

# Local filesystem media policy. Staging/production should mount both directories on
# encrypted persistent storage and keep them inaccessible to the web server.
MEDIA_UPLOAD_DIR=uploads
MEDIA_PRIVATE_UPLOAD_DIR=private_uploads
MEDIA_UPLOAD_MAX_BYTES=10485760
MEDIA_UPLOAD_CHUNK_BYTES=1048576
MEDIA_ACCESS_URL_EXPIRE_SECONDS=300
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,image/heic,image/heif,application/pdf,application/msword,application/vnd.ms-excel,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/x-hwp,application/haansofthwp,application/vnd.hancom.hwp,application/zip,text/plain,application/x-ipynb+json,application/json
MEDIA_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.heic,.heif,.pdf,.doc,.xls,.ppt,.docx,.xlsx,.pptx,.hwp,.zip,.txt,.ipynb
# First-party authenticated member navigation, excluding administrator accounts.
# Apply migration 0032_admin_usage before enabling the updated application.
USAGE_TRACKING_ENABLED=true
