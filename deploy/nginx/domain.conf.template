server {
    listen 80;
    listen [::]:80;
    server_name ${PUBLIC_HOST} ${PUBLIC_HOST_ALIASES};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 308 https://${PUBLIC_HOST}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${PUBLIC_HOST} ${PUBLIC_HOST_ALIASES};
    ssl_certificate /etc/letsencrypt/live/${TLS_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TLS_CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    if ($host != "${PUBLIC_HOST}") {
        return 308 https://${PUBLIC_HOST}$request_uri;
    }
    client_max_body_size 11m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_connect_timeout 10s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    location /api/ { proxy_pass http://backend:8000; }
    location = /health { proxy_pass http://backend:8000; }
    location = /health/ready { proxy_pass http://backend:8000; }
    location / { proxy_pass http://frontend-web:8080; }
}
